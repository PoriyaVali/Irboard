    "auto_detect_interface": true,
    "final": "دکتر‌موبایل‌جایزان",
    "default_domain_resolver": {
      "server": "remote"
    },

    "rule_set": [
      {
        "tag": "geoip-ir",
        "type": "remote",
        "format": "binary",
        "url": "https://drmobjay.com/route/geoip-ir.srs",
        "download_detour": "دکتر‌موبایل‌جایزان",
        "update_interval": "168h"
      },
      {
        "tag": "geosite-ir",
        "type": "remote",
        "format": "binary",
        "url": "https://drmobjay.com/route/geosite-ir.srs",
        "download_detour": "دکتر‌موبایل‌جایزان",
        "update_interval": "168h"
      },
      {
        "tag": "category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://drmobjay.com/route/geosite-category-ads-all.srs",
        "download_detour": "دکتر‌موبایل‌جایزان",
        "update_interval": "168h"
      }
    ]
  },

  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_rdrc": true
    },
    "clash_api": {
