{
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local",
        "detour": "دکتر‌موبایل‌جایزان"
      },
      {
        "type": "https",
        "tag": "remote",
        "server": "cloudflare-dns.com",
        "server_port": 443,
        "detour": "دکتر‌موبایل‌جایزان"
      },
      {
        "type": "udp",
        "tag": "ir",
        "server": "8.8.8.8",
        "server_port": 53,
        "detour": "دکتر‌موبایل‌جایزان"
      }
    ],
    "rules": [
      {
        "rule_set": ["geosite-ir"],
        "server": "ir"
      },
      {
        "domain_suffix": [".ir", ".xn--mgba3a4f16a"],
        "server": "ir"
      }
    ],
    "final": "remote",
    "strategy": "ipv4_only",
    "independent_cache": true
  },

  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "2001:0470:f9da:fdfa::1/64"
      ],
      "auto_route": true,
      "mtu": 1400,
      "stack": "gvisor",
      "strict_route": true,
      "route_exclude_address_set": ["geoip-ir"]
    },
    {
      "tag": "socks-in",
      "type": "socks",
      "listen": "127.0.0.1",
      "listen_port": 2333,
      "users": []
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 2334,
      "users": []
    }
  ],

  "outbounds": [
    {
      "tag": "دکتر‌موبایل‌جایزان",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["انتخاب خودکار"]
    },
    {
      "tag": "انتخاب خودکار",
      "type": "urltest",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 80,
      "idle_timeout": "10m",
      "interrupt_exist_connections": false,
      "outbounds": ["دکتر‌موبایل‌جایزان"]
    }
  ],

  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "stun",
        "action": "route",
        "outbound": "دکتر‌موبایل‌جایزان"
      },
      {
        "network": "udp",
        "port": [3478, 3479, 3480, 3481, 4244, 5222, 5223, 5228, 5242, 5349, 19302, 19305],
        "action": "route",
        "outbound": "دکتر‌موبایل‌جایزان"
      },
      {
        "rule_set": ["category-ads-all"],
        "action": "reject",
        "method": "default",
        "no_drop": false
      },
      {
        "clash_mode": "پراکسی سراسری",
        "action": "route",
        "outbound": "دکتر‌موبایل‌جایزان"
      },

      {
        "domain": [
          "youtube.com",
          "youtubei.googleapis.com",
          "googlevideo.com",
          "ytimg.com",
