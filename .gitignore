# composer.lock is committed on purpose: this is an application, not a library.
# Without it every install resolves its own dependency versions, so two panels set
# up a week apart do not run the same code and an upstream release can break a
# fresh install with nothing changed here.
yarn.lock
docker-compose.yml
.DS_Store
public/clients/*
workerman.webman.php.pid
workerman.log

/config/v2board.php
*.bak
*.bak_*
/workerman.log
/public/.user.ini
# Underscore-prefixed .php files are operator diagnostics dropped onto a live
# panel (e.g. _tuncheck.php, _tunmon.php, public/_oc.php). They are per-server
# scratch, sometimes reference private infrastructure, and must never ride a
# prod->repo sync into the public repo.
_*.php

# Runtime and operator artifacts that live inside a running panel's tree.
# Some of these are catastrophic to publish (storage/app/backups holds full
# database dumps with real user data), the rest are junk a prod->repo sync
# must never pick up.
/storage/app/backups/
*.sql.gz
/public/bot_files/
/public/assets/admin/1/
nohup.out
*~
/payment_debug_report.txt
/debug_payment.sh
/alanchand.html
/laravel-serve.php
*.bak2
/storage/.circuit-breaker
/storage/.webman-hash*
/storage/framework/laravel-serve.pid
/storage/framework/server-info.json
/storage/server_config_status.json
/public/.well-known/

# Backups written by scripts/patch_admin_anytls_tls.py next to the bundle it
# edits. Useful locally for an instant revert; never part of the tree.
*.prepatch
